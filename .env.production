# 用户态环境标识：用于业务代码判断当前是否为生产环境。
# User-facing environment label: used by business code to detect production.
VITE_USER_NODE_ENV = production

# 生产 API 入口：生产构建直接请求真实网关，不生成本地 dev proxy。
# Production API entry: production builds call the real gateway and do not generate a local dev proxy.
VITE_APP_BASE_API = https://api.launchpad.com
