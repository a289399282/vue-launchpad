# 用户态环境标识：用于业务代码判断当前是否为预发/测试环境。
# User-facing environment label: used by business code to detect staging/test environments.
VITE_USER_NODE_ENV = staging

# 业务 API 统一入口：预发环境仍使用 /api，由 Vite 代理到测试网关。
# Unified business API entry: staging still uses /api and proxies to the test gateway.
VITE_APP_BASE_API = /api

# 动态代理目标：vite.config.ts 会自动把 /api 转发到该测试环境网关。
# Dynamic proxy target: vite.config.ts forwards /api to this test gateway.
VITE_PROXY_API = https://staging-api.launchpad.com
