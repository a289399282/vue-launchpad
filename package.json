{
  "name": "vue-launchpad",
  "version": "1.0.0",
  "description": "A typed Vue 3 launchpad with dynamic UI engine injection.",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "imports": {
    "#app/*": "./src/*"
  },
  "scripts": {
    "launch": "tsx scripts/init.ts",
    "dev": "vite",
    "gen": "plop",
    "prepare": "husky",
    "typecheck": "vue-tsc --noEmit",
    "check": "pnpm biome check . && pnpm typecheck",
    "test": "vitest run",
    "test:run": "vitest run --coverage",
    "build": "pnpm typecheck && vite build",
    "build:staging": "pnpm typecheck && vite build --mode staging",
    "build:analyze": "cross-env ANALYZE=true pnpm build",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "keywords": [
    "vue",
    "vite",
    "typescript",
    "pinia",
    "unocss",
    "biome"
  ],
  "author": "LinkFuture",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/a289399282/vue-launchpad.git"
  },
  "bugs": {
    "url": "https://github.com/a289399282/vue-launchpad/issues"
  },
  "homepage": "https://a289399282.github.io/vue-launchpad/",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.2",
    "@types/nprogress": "^0.2.3",
    "@unocss/preset-wind3": "^66.7.0",
    "@unocss/transformer-directives": "^66.7.0",
    "@unocss/transformer-variant-group": "^66.7.0",
    "@unocss/vite": "^66.7.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.8",
    "cross-env": "^10.1.0",
    "fs-extra": "^11.3.5",
    "husky": "^9.1.7",
    "inquirer": "^14.0.2",
    "lint-staged": "^17.0.7",
    "picocolors": "^1.1.1",
    "plop": "^4.0.5",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-progress": "^0.0.7",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "axios": "^1.17.0",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,json,jsonc,css,md}": [
      "biome check --write"
    ]
  }
}
