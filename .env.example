# 用户态环境标识：业务代码读取 import.meta.env.VITE_USER_NODE_ENV 时的标准枚举值。
# User-facing environment label: the standard enum read from import.meta.env.VITE_USER_NODE_ENV.
VITE_USER_NODE_ENV = development

# 业务 API 统一入口：开发/预发通常配置为 /api，生产可配置为真实 http(s) 网关。
# Unified business API entry: use /api for dev/staging and an http(s) gateway in production.
VITE_APP_BASE_API = /api

# 动态代理目标：任意 VITE_PROXY_XXX 都会被 vite.config.ts 自动映射为 /xxx 代理前缀。
# Dynamic proxy target: every VITE_PROXY_XXX is automatically mapped to a /xxx proxy prefix by vite.config.ts.
VITE_PROXY_API = http://localhost:8080

# API Mock 开关：选择 MSW mock 能力后，可在 .env.development.local 中开启。
# API Mock switch: after selecting MSW mock support, enable it in .env.development.local.
VITE_MOCK = false
