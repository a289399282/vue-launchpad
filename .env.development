# 用户态环境标识：用于业务代码判断当前是否为本地开发环境。
# User-facing environment label: used by business code to detect local development.
VITE_USER_NODE_ENV = development

# 业务 API 统一入口：开发环境走 Vite dev server 的 /api 代理。
# Unified business API entry: local development goes through the Vite dev-server /api proxy.
VITE_APP_BASE_API = /api

# 动态代理目标：vite.config.ts 会自动把 VITE_PROXY_API 映射成 /api 代理规则。
# Dynamic proxy target: vite.config.ts maps VITE_PROXY_API into the /api proxy rule.
VITE_PROXY_API = http://localhost:8080
